# Opcional: o painel funciona com o CSV sem configurar este arquivo.
# Copie para secrets.toml e substitua os exemplos pelos dados do Supabase.
[connections.postgresql]
dialect = "postgresql"
driver = "psycopg"
host = "SEU_HOST_SUPABASE"
port = 5432
database = "postgres"
username = "SEU_USUARIO"
password = "SUA_SENHA"

[connections.postgresql.query]
sslmode = "require"
connect_timeout = "5"
